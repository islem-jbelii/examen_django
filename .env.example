# Copy this file to .env and fill in your values
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — set USE_SQLITE=True for local dev (SQLite fallback)
USE_SQLITE=True
DATABASE_URL=postgres://user:password@localhost:5432/careerpathtn_db

# PostgreSQL individual settings (used when USE_SQLITE=False)
DB_NAME=careerpathtn_db
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432
